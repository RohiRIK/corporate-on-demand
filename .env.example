# Environment variables for cod.
#
# Copy to .env only if you need to override a default. None of these are
# required, and none of them are secrets.
#
# There are deliberately NO credential variables in this file. The model is
# free and opencode runs unauthenticated; that is what keeps the blast radius
# of a compromised agent at "source code leaves the host". Do not add an API
# key here without reading docs/SECURITY_POSTURE.md first.

# Path to the workspace file. Default: ./cod.json
#COD_WORKSPACE=/path/to/cod.json

# Where cod keeps its own state. Default: ~/.local/share/cod
#COD_STATE_DIR=/path/to/state

# Container image tag to build and run. Default: cod-sandbox:1.3.12
#COD_IMAGE=cod-sandbox:1.3.12

# The workspace file the in-container supervisor reads. This one is set inside
# the container, not by you. Default: /cod/cod.json
#COD_WORKSPACE_FILE=/cod/cod.json

# Pinned checksum for the opencode download. You should not need to set this;
# scripts/vendor-opencode.sh has the verified value built in. It exists so a
# different build can be pinned deliberately.
#COD_OPENCODE_SHA256=f9dab32248695e9ebd56b16a1921798fd85112cf5a69c7dfd0cabc1e17be4a11
