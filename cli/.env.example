# cod is credential-free by design: opencode 1.18.31 needs NO API keys.
# Do NOT add ANTHROPIC_API_KEY / OPENAI_API_KEY here.
# Every value below is optional; defaults are shown.

# Container image and naming
COD_IMAGE=oven/bun:1.3.12
COD_NAME_PREFIX=cod
COD_WORKSPACE_ROOT=.cod/workspaces

# opencode agent runtime (self-contained ELF, no Node in the container)
COD_OPENCODE_VERSION=1.18.31
COD_AGENT_MODEL=anthropic/claude-sonnet-4-5
COD_AGENT_TIMEOUT_MS=900000

# Scheduler
COD_CRON_TICK=60
COD_LOG_LEVEL=info
