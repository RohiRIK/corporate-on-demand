{
  "name": "cod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One Docker container per workspace, running credential-free opencode agents on a Bun cron scheduler.",
  "bin": { "cod": "src/index.ts" },
  "engines": { "bun": ">=1.3.12" },
  "scripts": {
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "build": "bun build src/index.ts --compile --outfile dist/cod"
  },
  "keywords": ["cli", "agents", "docker", "opencode", "bun"],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "1.3.12",
    "typescript": "5.9.3"
  }
}
