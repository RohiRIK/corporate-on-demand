# The workspace image.
#
# Two things are pinned deliberately, because a mutable tag is how a build
# silently starts producing a different container:
#
#   - the base image by digest, not by tag
#   - the opencode binary, vendored into the repo rather than resolved at
#     build time through a version manager
#
# `cod doctor` reports the opencode version, so drift between the host and
# the image is visible instead of surprising.

FROM oven/bun@sha256:8956c7667fa17beb6e3c664115e66bdacfe502da5d99603626e74c197bdef160

# Tools an agent needs to build a project. Installed in one layer so the apt
# cache is reused when the toolchain list changes.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git \
      curl \
      ca-certificates \
      build-essential \
      python3 \
      python3-pip \
      jq \
      ripgrep \
      unzip \
      postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# opencode 1.18.31 - a self-contained ELF binary, so no Node layer is needed
# and no runtime is resolved at build time.
COPY --chmod=755 vendor/opencode/1.18.31/opencode /usr/local/bin/opencode

# The unprivileged user every agent runs as. UID 1000 matches the --user flag
# the CLI passes, so the two cannot drift apart silently.
RUN useradd --create-home --uid 1000 --shell /bin/bash cod

COPY --chmod=755 docker/entrypoint.sh /usr/local/bin/entrypoint.sh

# The supervisor reads the mounted workspace and registers its cron jobs on
# Bun.cron. It is run via docker exec rather than from the entrypoint, so a
# crash is visible as a failed exec instead of a restart loop.
COPY --chmod=644 src/supervisor.ts src/workspace.ts src/scheduler.ts src/errors.ts /usr/local/lib/cod/
RUN printf '#!/bin/sh\nexec bun run /usr/local/lib/cod/supervisor.ts\n' > /usr/local/bin/supervisor \
    && chmod 755 /usr/local/bin/supervisor

USER cod
WORKDIR /work

# `git config --system` as a non-root user fails; the safe.directory setting is
# what lets an agent read a bind-mounted repository owned by another uid.
RUN git config --global --add safe.directory '*' || true

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
